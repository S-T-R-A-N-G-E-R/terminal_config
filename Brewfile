brew "k9s"        # Kubernetes cluster UI
brew "btop"       # Beautiful resource monitor (CPU/RAM)
brew "yq"         # The 'jq' equivalent for YAML (Kubernetes/CI files)
brew "jq"         # Command-line JSON processor
brew "zellij"     # Workspace multiplexer (keeps scripts running safely)
brew "httpie"     # The modern 'curl' for testing APIs
brew "gh"         # GitHub CLI for auth and repo management
brew "visidata"   # Terminal spreadsheet for massive CSV/JSON files
brew "harlequin"  # Terminal SQL IDE for databases

